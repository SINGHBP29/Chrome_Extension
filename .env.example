# --- Docker Compose defaults (safe for local demo) ---
POSTGRES_DB=orchestrator_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# If your laptop already uses 5432, change this (e.g. 5433)
POSTGRES_HOST_PORT=5432

ORCHESTRATOR_PORT=8000
NOTIFICATION_PORT=8001
UI_PORT=8080

# --- LLM (optional; required for /api/chat) ---
# Set one of these:
GOOGLE_API_KEY=
GEMINI_API_KEY=

# --- Optional: override DB_* inside orchestrator ---
# NOTE: when running with Docker Compose, the Postgres host is `db` (not `localhost`)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/orchestrator_db

# --- Optional tuning ---
LLM_REQUESTS_PER_SECOND=0.2
LLM_MAX_RETRIES=2
LLM_TIMEOUT=60
