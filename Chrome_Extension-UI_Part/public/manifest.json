{
  "manifest_version": 3,
  "name": "Team Assistant",
  "version": "1.0",
  "description": "Chrome extension popup for the Team Assistant — quick actions, notifications and shortcuts.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open Team Assistant"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "notifications",
    "identity",
    "identity.email",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://0.0.0.0/*",
    "https://www.googleapis.com/*",
    "https://gmail.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "472515862729-q0rqtthelrofeps69hte51p0bi6opta7.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "icons": {
    "16": "favicon.ico",
    "48": "favicon.ico",
    "128": "favicon.ico"
  }
}